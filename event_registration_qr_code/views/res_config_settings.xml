<odoo>
    <record id="res_config_settings_view_form_inherit_qr_code_text" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.qr.code.text</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="event.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <div name="registration_setting_container" position="inside">
                <div class="col-12 col-lg-6 o_setting_box" id="show_qr_code_text"
                     title="Display the QR code value as readable text below the QR code on printed tickets.">
                    <div class="o_setting_left_pane">
                        <field name="show_qr_code_text"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label string="QR code value on tickets" for="show_qr_code_text"/>
                        <div class="text-muted">
                            Display the QR code value as readable text below the QR code on printed tickets
                        </div>
                    </div>
                </div>
            </div>
        </field>
    </record>
</odoo>
